# Local Compose disables model providers and does not inject this file into the app.
# Host settings do not load .env implicitly. Compose forwards observability flags explicitly.
APP_PORT=8010
LLM_PROVIDER=disabled
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CREDENTIALS_JSON=
LLM_MAX_CALLS=4
LLM_MAX_TOKENS=12000
LLM_BUDGET_USD=0.02
# Conservative configurable estimates, not a billing statement.
LLM_INPUT_USD_PER_MILLION=0.50
LLM_OUTPUT_USD_PER_MILLION=2.00

# Observability is separate from model inference and off by default.
# A project name alone does not enable exports or credential discovery.
MDS_TELEMETRY_ENABLED=0
MDS_BIGQUERY_ENABLED=0
MDS_BIGQUERY_DATASET=mds_analytics
OTEL_SERVICE_NAME=madrid-delivery-sim
# With tracing enabled: project -> Cloud Trace; otherwise OTLP endpoint -> console.
OTEL_EXPORTER_OTLP_ENDPOINT=
