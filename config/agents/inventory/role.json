{
  "schema_version": 1,
  "role": "inventory",
  "version": "1",
  "policy": "deterministic",
  "soul_file": "SOUL.md",
  "accepts": ["basket.requested", "shipment.delayed", "shipment.received", "reservation.expire"],
  "emits": ["inventory.decided", "shipment.received"],
  "tools": ["inventory.read", "inventory.reserve", "inventory.release", "inventory.delay", "inventory.receive", "memory.read", "memory.write", "queue.publish"],
  "limits": {
    "events_per_run": 100,
    "tool_calls_per_event": 8,
    "tool_calls_per_run": 400,
    "memory_entries": 32,
    "memory_bytes": 16384,
    "model_calls": 0,
    "model_tokens": 0,
    "model_usd": 0
  }
}
