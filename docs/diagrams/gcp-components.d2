...@common
direction: down
grid-columns: 2
horizontal-gap: 168
local: 01 / Local Docker {
  direction: down
  class: local
  ui: "Operator UI\nTrusted controller"
  agents: "Scoped Python\nRole workers"
  db: "PostgreSQL\nDomain · queue · memory\nBudgets · audit" {shape: cylinder}
  caller: "CloudJudge client\nAudience-bound ID token\nValidated verdict + usage"
  ui -> agents
  agents <-> db
  agents -> caller: "Optional\njudge policy"
}
gcp: 02 / Dedicated GCP project {
  direction: down
  class: cloud
  iam: "Cloud Run IAM\nInvocation check"
  gateway: "Cloud Run\nJudgement service"
  vertex: "Google publisher model\nVertex REST"
  registry: "Artifact Registry\nPinned gateway image"
  logs: "Platform logs\nStructured gateway stdout"
  iam -> gateway
  registry -> gateway: Image {style.stroke-dash: 4}
  gateway -> vertex: "Runtime service\naccount ADC"
  gateway -> logs
}
local <-> gcp: HTTPS
(** -> **)[*].style: {...${edge-style}}
(** <-> **)[*].style: {...${edge-style}}
