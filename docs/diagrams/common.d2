# Precise monochrome system. D2 owns all placement and connector routing.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
  edge-style: {
    stroke: "#353535"
    stroke-width: 1
    border-radius: 0
    font-color: "#262626"
    font-size: 16
    font: mono
    italic: false
    bold: false
  }
}
style.fill: "#FFFFFF"
***.class: state
***.style: {
  font-color: "#171717"
  stroke-width: 1
  border-radius: 0
  shadow: false
  bold: false
}
classes: {
  local: {
    label.near: top-left
    style.fill: "#FAFAFA"
    style.stroke: "#CECECE"
    style.font: mono
    style.font-size: 16
  }
  cloud: {
    label.near: top-left
    style.fill: "#FAFAFA"
    style.stroke: "#CECECE"
    style.font: mono
    style.font-size: 16
  }
  state: {
    style.font-size: 18
    style.fill: "#FFFFFF"
    style.stroke: "#686868"
  }
  durable: {
    style.font-size: 18
    style.fill: "#FFFFFF"
    style.stroke: "#353535"
  }
  caution: {
    style.font-size: 18
    style.fill: "#FFFFFF"
    style.stroke: "#353535"
    style.stroke-dash: 4
  }
}
