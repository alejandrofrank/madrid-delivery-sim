...@common
shape: sequence_diagram
household: Household
restaurant: Restaurant
market: "Nearest\nmarket"
other: "Another\nmarket"
delivery: "Dispatcher\n+ courier"
sourcing: 01 / Source + reserve {
  class: local
  household -> restaurant: Queued meal call
  restaurant -> market: Ingredient request
  market -> other: Shortage forwarding
  market -> restaurant: "Reserved stock\nthen arrival"
  other -> restaurant: "Reserved + arrived\nif forwarded"
}
consent: 02 / Explicit substitution consent {
  class: local
  restaurant -> household: Substitution offer
  household -> restaurant: Explicit approval
}
fulfill: 03 / Cook + deliver {
  class: local
  restaurant -> delivery: Cook from arrived stock
  delivery -> household: Confirmed delivery
}
(** -> **)[*].style: {...${edge-style}}
