...@common
shape: sequence_diagram
controller: "Trusted\ncontroller"
agent: "Scoped\nLocalAgent"
queue: "PostgreSQL\nqueue"
tools: "Domain tools\n+ memory"
claim: 01 / Address + claim {
  class: local
  controller -> queue: Addressed event
  agent -> queue: "Claim with\nrole subscriptions"
  queue -> agent: "Event + attempt\n+ fenced lease token" {style.stroke-dash: 4}
}
reservation: 02 / Committed reservation {
  class: local
  agent -> queue: "Reserve attempt +\nfull tool allowance"
}
effects: 03 / Atomic effects · commit or roll back {
  class: local
  agent -> queue: "Begin transaction\nValidate lease"
  agent -> tools: "Authoritative facts\n+ current-context memory"
  agent -> tools: "Allowed actions\n+ memory revisions"
  agent -> queue: "Decision receipt\n+ outgoing events"
  agent -> queue: ACK in same transaction
}
(** -> **)[*].style: {...${edge-style}}
