  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action with hover, keyboard focus and disabled states.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Watch it run</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--ui-strong-line,#9da99b);border-radius:var(--ui-radius,12px);font:500 16px/1.25 var(--ui-font,\"IBM Plex Sans\",sans-serif);cursor:pointer;text-decoration:none;transition:background-color var(--ui-motion,220ms) var(--ui-ease,cubic-bezier(.16,1,.3,1)),border-color var(--ui-motion,220ms) var(--ui-ease,cubic-bezier(.16,1,.3,1));background:var(--ui-accent,#087c3b);border-color:var(--ui-accent,#087c3b);color:var(--ui-accent-ink,#fffdf8);font-weight:600;}.ds-button-primary:hover:not(:disabled){background:var(--ui-accent-hover,#066631);border-color:var(--ui-accent-hover,#066631);}.ds-button-primary:focus-visible{outline:3px solid var(--ui-accent,#087c3b);outline-offset:4px}.ds-button-primary:disabled{background:var(--ui-raised,#eee8dd);color:var(--ui-faint,#626e63);border-color:var(--ui-line,#d9d7cb);cursor:not-allowed;opacity:1}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition-duration:0s}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared secondary action with hover, keyboard focus and disabled states.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Open evidence</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 16px;border:1px solid var(--ui-strong-line,#9da99b);border-radius:var(--ui-radius,12px);font:500 16px/1.25 var(--ui-font,\"IBM Plex Sans\",sans-serif);cursor:pointer;text-decoration:none;transition:background-color var(--ui-motion,220ms) var(--ui-ease,cubic-bezier(.16,1,.3,1)),border-color var(--ui-motion,220ms) var(--ui-ease,cubic-bezier(.16,1,.3,1));background:var(--ui-surface,#fffdf8);color:var(--ui-ink,#14291e);}.ds-button-secondary:hover:not(:disabled){background:var(--ui-hover,#e6eddf);border-color:var(--ui-ink,#14291e);}.ds-button-secondary:focus-visible{outline:3px solid var(--ui-accent,#087c3b);outline-offset:4px}.ds-button-secondary:disabled{background:var(--ui-raised,#eee8dd);color:var(--ui-faint,#626e63);border-color:var(--ui-line,#d9d7cb);cursor:not-allowed;opacity:1}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition-duration:0s}}"
