# Shared dark operations palette. D2 owns all placement and connector routing.
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
  }
  edge-style: {
    stroke: "#81949F"
    stroke-width: 1
    border-radius: 5
    font-color: "#A8B7C0"
    font-size: 16
    italic: false
    bold: false
  }
}
style.fill: "#151C20"
***.class: state
***.style: {
  font-color: "#E7EDF0"
  stroke-width: 1
  border-radius: 5
  shadow: false
  bold: false
}
classes: {
  local: {
    label.near: top-left
    style.fill: "#101518"
    style.stroke: "#536770"
    style.font-size: 16
  }
  cloud: {
    label.near: top-left
    style.fill: "#101518"
    style.stroke: "#536770"
    style.font-size: 16
  }
  state: {
    style.font-size: 18
    style.fill: "#151C20"
    style.stroke: "#536770"
  }
  durable: {
    style.font-size: 18
    style.fill: "#193B36"
    style.stroke: "#63D5C5"
  }
  caution: {
    style.font-size: 18
    style.fill: "#151C20"
    style.stroke: "#81949F"
    style.stroke-dash: 4
  }
}
